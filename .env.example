# Copy to .env and fill in. .env is git-ignored and must never be committed.
# In CI, set these as secrets in the pipeline instead of shipping a file.

# --- Target environment -------------------------------------------------------
BASE_URL=https://www.saucedemo.com

# --- Credentials --------------------------------------------------------------
# Required. No default: the suite fails fast rather than falling back to a
# hardcoded password.
USER_PASSWORD=

# --- Accounts -----------------------------------------------------------------
# Optional; these defaults match the accounts SauceDemo publishes on its login page.
STANDARD_USERNAME=standard_user
LOCKED_OUT_USERNAME=locked_out_user
PROBLEM_USERNAME=problem_user
PERFORMANCE_GLITCH_USERNAME=performance_glitch_user
ERROR_USERNAME=error_user
VISUAL_USERNAME=visual_user
